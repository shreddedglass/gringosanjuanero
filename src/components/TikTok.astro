---
import { tiktokId } from '../lib/utils';
interface Props { url?: string; title?: string; lazy?: boolean }
const { url, title = 'Míralo en video', lazy = false } = Astro.props;
const id = tiktokId(url);
---
{url && (
  <div class="tiktok-box">
    <h3>{title}</h3>
    {id ? (
      <blockquote class="tiktok-embed" cite={url} data-video-id={id} style="max-width: 605px; min-width: 300px;">
        <section><a href={url} target="_blank" rel="noopener">Ver el video en TikTok</a></section>
      </blockquote>
    ) : (
      <a class="btn btn-dark" href={url} target="_blank" rel="noopener">Ver el video en TikTok</a>
    )}
    {id && !lazy && <script is:inline async src="https://www.tiktok.com/embed.js"></script>}
  </div>
)}
