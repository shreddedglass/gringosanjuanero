---
import { tiktokId } from '../lib/utils';
interface Props { url?: string; title?: string; lazy?: boolean }
const { url, title = 'Míralo en video', lazy = false } = Astro.props;
const id = tiktokId(url);
const src = id ? `https://www.tiktok.com/player/v1/${id}?music_info=1&description=1&autoplay=1&muted=1` : undefined;
---
{url && (
  <div class="tiktok-box">
    <h3>{title}</h3>
    {src ? (
      <div class="tiktok-player">
        {lazy
          ? <iframe data-tiktok-src={src} title={title} allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture; web-share" allowfullscreen></iframe>
          : <iframe src={src} title={title} loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture; web-share" allowfullscreen></iframe>}
      </div>
    ) : (
      <a class="btn btn-dark" href={url} target="_blank" rel="noopener">Ver el video en TikTok</a>
    )}
  </div>
)}
