---
import '../styles/global.css';
import site from '../data/site.json';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  active?: 'inicio' | 'explorar' | 'hospedarse' | 'comer' | 'blog' | 'contacto';
  type?: 'website' | 'article';
  jsonld?: object;
}
const { title, description = site.descripcion, image = '/images/og-default.png', active, type = 'website', jsonld } = Astro.props;
const fullTitle = title ? `${title} | Gringo Sanjuanero` : site.lema;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const nav = [
  { key: 'explorar', label: 'Dónde Explorar', href: '/donde-explorar/' },
  { key: 'hospedarse', label: 'Dónde Hospedarse', href: '/donde-hospedarse/' },
  { key: 'comer', label: 'Dónde Comer', href: '/donde-comer/' },
  { key: 'blog', label: 'Blog', href: '/blog/' },
];
const footerNav = [{ key: 'inicio', label: 'Inicio', href: '/' }, ...nav, { key: 'contacto', label: 'Contacto', href: '/contacto/' }];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="es_DO" />
  <meta property="og:site_name" content="Gringo Sanjuanero" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#F6B826" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a class="sr-only" href="#contenido">Saltar al contenido</a>
  <header class="wrap site-header">
    <a class="brand" href="/">
      <img class="logo-circle" src="/images/logo.png" alt="" width="58" height="58" />
      <span>El Gringo<br />Sanjuanero</span>
    </a>
    <nav class="main-nav" aria-label="Principal">
      {nav.map((n) => (
        <a class="nav-link" href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="btn btn-dark btn-sm" href="/contacto/" aria-current={active === 'contacto' ? 'page' : undefined}>Contacto</a>
    </nav>
  </header>

  <main id="contenido">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-brand">
        <img class="logo-circle" src="/images/logo.png" alt="" width="46" height="46" />
        <span>{site.lema}</span>
      </div>
      <nav aria-label="Pie de página">
        {footerNav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={site.tiktok} target="_blank" rel="noopener">TikTok</a>
        <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
      </nav>
      <span class="copy">© {year} gringosanjuanero.com</span>
    </div>
  </footer>
</body>
</html>
