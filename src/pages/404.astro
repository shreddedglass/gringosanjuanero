---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada">
  <section class="wrap" style="padding: 80px 24px 120px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center;">
    <img src="/images/logo.png" alt="" width="180" style="transform: rotate(-6deg);" />
    <h1 class="h-hero">¡Diablo! Te perdiste.</h1>
    <p class="lead">Esta página no existe, pero el sur tiene mucho más que ver.</p>
    <a class="btn btn-primary" href="/">Volver al inicio</a>
  </section>
</Layout>
