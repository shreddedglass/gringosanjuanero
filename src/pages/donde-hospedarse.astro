---
import CategoryPage from '../components/CategoryPage.astro';
const seoArriba = "¿No sabes dónde hospedarse en San Juan de la Maguana? Aquí te ayudo. Desde los mejores hoteles en San Juan de la Maguana hasta cabañas en la montaña y villas con piscina, solo pongo sitios donde me he quedado de verdad. Y si prefieres dormir bajo las estrellas, también hay rincones para acampar al lado del río.";
const seoAbajo = {
  "titulo": "Hoteles, cabañas y villas en San Juan de la Maguana y el Sur",
  "parrafos": [
    "Muchos de los buenos sitios de dónde dormir en el sur de República Dominicana no salen en las grandes páginas de reservas. Por eso armé esta guía: hoteles en San Juan de la Maguana para quien viene de paso o por trabajo, cabañas en San Juan de la Maguana para una escapada en pareja y villas con piscina en San Juan de la Maguana para ir en familia o con amigos.",
    "Si vas para la costa, también voy agregando hoteles en Barahona, y para los aventureros, lugares para acampar en República Dominicana cerca de ríos y saltos. Filtra por pueblo o por tipo de alojamiento. En fines de semana largos y fiestas patronales los sitios se llenan, así que reserva con tiempo."
  ]
};
---
<CategoryPage
  seoTitulo="Mejores hoteles en San Juan de la Maguana"
  seoArriba={seoArriba}
  seoAbajo={seoAbajo}
  formulario
  pagina="hospedarse"
  titulo="Dónde Hospedarse"
  palabra="Hospedarse"
  color="#4E6B2C"
  intro="Hoteles, casas de campo y sitios para acampar donde me he quedado. Filtra por lugar o por plan y encuentra dónde dormir en el sur."
  descripcion="Los mejores hoteles en San Juan de la Maguana, cabañas, villas con piscina y lugares para acampar en el Sur, todos probados por el Gringo Sanjuanero."
/>
