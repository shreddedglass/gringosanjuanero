---
import CategoryPage from '../components/CategoryPage.astro';
const seoArriba = "¿Buscando el mejor restaurante en San Juan de la Maguana? Aquí te dejo dónde comer en San Juan de la Maguana y en todo el Sur: desde el comedor de la esquina con el mejor locrio del pueblo hasta restaurantes para una cena especial. Ven con hambre, que aquí nadie se queda con ganas.";
const seoAbajo = {
  "titulo": "Los mejores restaurantes en San Juan de la Maguana y el Sur",
  "parrafos": [
    "Esta guía reúne los mejores restaurantes en San Juan de la Maguana que he probado en persona: comedores con el plato del día, friquitines para picar algo y restaurantes en San Juan de la Maguana para ir en pareja o celebrar con amigos. Si lo que quieres es comida típica del sur dominicano, no te puedes ir sin probar un chivo guisado en San Juan de la Maguana, mejor todavía con chenchén.",
    "Bajando a la costa, también voy agregando restaurantes en Barahona con mariscos frescos. Y si andas cuidando el bolsillo, filtra por “Económico” para encontrar comida económica en San Juan de la Maguana que sabe a casa. En cada lugar busca el “Consejo del gringo” para saber qué pedir."
  ]
};
---
<CategoryPage
  seoTitulo="Mejor restaurante en San Juan de la Maguana"
  seoArriba={seoArriba}
  seoAbajo={seoAbajo}
  formulario
  pagina="comer"
  titulo="Dónde Comer"
  palabra="Comer"
  color="#B5461F"
  intro="Restaurantes, comedores y friquitines del sur que de verdad valen la pena. Filtra por lugar o por plan y come como un sanjuanero."
  descripcion="El mejor restaurante en San Juan de la Maguana y dónde comer en todo el Sur: comedores, friquitines, cafés y comida típica probados por el Gringo Sanjuanero."
/>
